# DevBox project configuration.
# Plain KEY=value lines. Read by the `devbox` CLI, never executed as a whole file.
# Commands below run with `bash -c` from the project root.

DEVBOX_VERSION={{DEVBOX_VERSION}}
DEVBOX_PROJECT={{PROJECT_NAME}}
DEVBOX_SHAPE={{SHAPE}}
DEVBOX_STACK={{STACK}}

# Verify gates, run in this order by `devbox verify`, by `devbox run` after every task, and by CI.
# Leave a value empty to skip that gate. Every project should at least have LINT and TEST.
DEVBOX_FORMAT_CMD={{FORMAT_CMD}}
DEVBOX_LINT_CMD={{LINT_CMD}}
DEVBOX_TYPECHECK_CMD={{TYPECHECK_CMD}}
DEVBOX_TEST_CMD={{TEST_CMD}}
DEVBOX_BUILD_CMD={{BUILD_CMD}}

# AFK runner (`devbox run`). The prompt for each task is piped to this command on stdin.
# Default: Claude Code headless in auto permission mode (a classifier blocks risky actions).
# Stricter: claude -p --permission-mode acceptEdits --allowedTools "Bash(git *)" "Bash(npm *)" --output-format json --max-turns 120
# Fully unattended only inside a disposable container or VM: add --dangerously-skip-permissions
# Any other agent CLI works if it reads the prompt from stdin and exits non-zero on failure.
DEVBOX_AGENT_CMD=claude -p --permission-mode auto --output-format json --max-turns 120

# Branches `devbox run` refuses to work on directly.
DEVBOX_PROTECTED_BRANCHES=main master trunk production prod release
